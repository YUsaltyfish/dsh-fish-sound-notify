{
  "name": "dsh-fish-sound-notify",
  "version": "0.2.0",
  "description": "Plays a Windows system notification sound when the agent opens a question dialog, when it asks for permission, and when a conversation turn ends. DSH 组合包：弹出选项卡时、请求权限时、对话回合结束时播放系统提示音。",
  "author": "蓝色大肥鱼 (BlueFatFish)",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "plugin",
    "notification",
    "sound",
    "windows",
    "notify"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.1.0-rc.1"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-alpha.1 <0.2.0-0 || >=0.1.1-alpha.1 <0.2.0-0 || >=0.1.2-alpha.1 <0.2.0-0 || >=0.1.3-alpha.1 <0.2.0-0 || >=0.1.4-alpha.1 <0.2.0-0 || >=0.1.5-alpha.1 <0.2.0-0 || >=0.1.6-alpha.1 <0.2.0-0 || >=0.2.0",
    "@deepseek-ai/schemastery": "^3.18.0"
  }
}
